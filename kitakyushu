<script>
(function () {
  var MAPS = 'https://www.google.com/maps/';

  // Google Maps links
  // Single place: route from the viewer's current location to it
  document.querySelectorAll('a[data-q]').forEach(function (a) {
    var q = a.getAttribute('data-q');
    a.href = MAPS + 'dir/?api=1&destination=' + encodeURIComponent(q) + '&travelmode=' + (a.getAttribute('data-mode') || 'transit');
    a.target = '_blank';
    a.rel = 'noopener';
    a.setAttribute('aria-label', '在 Google 地圖查看前往路線：' + q);
  });
  document.querySelectorAll('a[data-to]').forEach(function (a) {
    var f = a.getAttribute('data-from'), t = a.getAttribute('data-to');
    a.href = MAPS + 'dir/?api=1&origin=' + encodeURIComponent(f) + '&destination=' + encodeURIComponent(t) + '&travelmode=' + (a.getAttribute('data-mode') || 'transit');
    a.target = '_blank';
    a.rel = 'noopener';
    a.setAttribute('aria-label', '在 Google 地圖查看路線：' + f + ' 到 ' + t);
  });

  // Chapters
  var pages = Array.prototype.slice.call(document.querySelectorAll('.page'));
  var ids = pages.map(function (p) { return p.id.replace('p-', ''); });
  var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
  var pager = document.getElementById('pager');

  function show(id, push) {
    var i = ids.indexOf(id);
    if (i < 0) { id = 'cover'; i = 0; }
    pages.forEach(function (p) { p.hidden = p.id !== 'p-' + id; });
    chips.forEach(function (c) {
      if (c.getAttribute('data-page') === id) { c.setAttribute('aria-current', 'page'); c.scrollIntoView({ inline: 'center', block: 'nearest' }); }
      else c.removeAttribute('aria-current');
    });
    pager.innerHTML = '';
    if (i > 0) {
      var pv = document.createElement('button');
      pv.type = 'button'; pv.className = 'pv';
      pv.textContent = '← ' + pages[i - 1].getAttribute('data-title');
      pv.addEventListener('click', function () { show(ids[i - 1], true); });
      pager.appendChild(pv);
    }
    if (i < ids.length - 1) {
      var nx = document.createElement('button');
      nx.type = 'button'; nx.className = 'nx';
      nx.textContent = pages[i + 1].getAttribute('data-title') + ' →';
      nx.addEventListener('click', function () { show(ids[i + 1], true); });
      pager.appendChild(nx);
    }
    if (push) {
      try { history.replaceState(null, '', '#' + id); } catch (e) {}
      window.scrollTo(0, 0);
    }
  }
  document.querySelectorAll('[data-page]').forEach(function (b) {
    b.addEventListener('click', function () { show(b.getAttribute('data-page'), true); });
  });
  window.addEventListener('hashchange', function () { show(location.hash.replace('#', ''), false); });
  show(location.hash.replace('#', '') || 'cover', false);

  // Countdown
  var el = document.getElementById('count');
  var now = new Date();
  var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  var start = new Date(2026, 11, 14);
  var diff = Math.round((start - today) / 86400000);
  if (diff > 0) {
    el.textContent = '距離出發還有 ' + diff + ' 天';
  } else if (diff > -5) {
    var n = 1 - diff;
    el.textContent = '今天是旅行第 ' + n + ' 天 ';
    var go = document.createElement('button');
    go.type = 'button'; go.textContent = '看 Day ' + n;
    go.addEventListener('click', function () { show('day' + n, true); });
    el.appendChild(go);
  } else {
    el.textContent = '旅程結束，歡迎回家';
  }

  // Packing list (remembered in this browser only)
  var KEY = 'kitakyushu-pack-v1';
  var boxes = Array.prototype.slice.call(document.querySelectorAll('.pack input[type=checkbox]'));
  var saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { saved = {}; }
  function update() {
    var done = boxes.filter(function (b) { return b.checked; }).length;
    var pct = boxes.length ? Math.round(done / boxes.length * 100) : 0;
    document.getElementById('prog').textContent = '已打包 ' + done + ' / ' + boxes.length;
    var bar = document.getElementById('bar');
    bar.querySelector('i').style.width = pct + '%';
    bar.setAttribute('aria-valuenow', pct);
  }
  function persist() {
    var o = {};
    boxes.forEach(function (b) { if (b.checked) o[b.getAttribute('data-k')] = 1; });
    try { localStorage.setItem(KEY, JSON.stringify(o)); } catch (e) {}
  }
  boxes.forEach(function (b) {
    b.checked = !!saved[b.getAttribute('data-k')];
    b.addEventListener('change', function () { update(); persist(); });
  });
  document.getElementById('reset').addEventListener('click', function () {
    boxes.forEach(function (b) { b.checked = false; });
    update(); persist();
  });
  update();
})();
</script>

</body></html>
