      <p class="eyebrow">Flight Info</p>
      <h2 class="sec-title">航班</h2>
    </div>

    <div class="pass">
      <div class="legs">
        <div><div class="day">12.14 (一) 03:00</div><div class="apt">TPE</div><div class="city">台北</div></div>
        <div class="mid"><span>2 小時 15 分</span><span class="dash"></span><span>StarFlyer 7G800</span></div>
