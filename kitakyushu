      </div>
      <div class="info">
        <div><span>航空公司</span><b>StarFlyer</b></div>
        <div><span>航班</span><b>7G800</b></div>
        <div><span>行李</span><b>30 kg</b></div>
      </div>
    </div>

    <div class="pass">
      <div class="legs">
        <div><div class="day">12.18 (五) 23:50</div><div class="apt">KKJ</div><div class="city">北九州</div></div>
        <div class="mid"><span>2 小時 40 分</span><span class="dash"></span><span>StarFlyer 7G801</span></div>
        <div class="r"><div class="day">12.19 (六) 01:30</div><div class="apt">TPE</div><div class="city">台北</div></div>
      </div>
      <div class="info">
        <div><span>航空公司</span><b>StarFlyer</b></div>
        <div><span>航班</span><b>7G801</b></div>
        <div><span>行李</span><b>30 kg</b></div>
      </div>
    </div>
    <div class="actions"><a class="map" data-q="北九州空港"><svg class="i"><use href="#i-route"/></svg>到北九州機場</a></div>
  </div>

  <div class="stack" style="margin-top:34px">
    <div>
      <p class="eyebrow">Stay Info</p>
      <h2 class="sec-title">住宿</h2>
