<style>
/* Layout concept: pocket guidebook. A sticky chapter strip on top, one chapter per screen,
   each day told as a vertical timeline in its own colour, every place one tap from Google Maps. */
:root{
  --bg:#FFFAF1; --surface:#FFFFFF; --surface-2:#F3EDE1; --fg:#3E3F44; --muted:#6E7278; --line:#E7DFD1;
  --blue:#72A9C2; --blue-ink:#25607C; --blue-soft:#E1EEF4;
  --panel:#3F7C99; --panel-ink:#FFFFFF;
  --plum:#86616E;
  --mat:#F4EEE3;
  --stamp:#B93D37; --stamp-soft:#FBE6E3;
  --d1:#F0BCC0; --d1-ink:#5B2F3A;
  --d2:#B5CF4A; --d2-ink:#2F3A0A;
  --d3:#F2DE8A; --d3-ink:#4A3F0C;
  --d4:#66749B; --d4-ink:#FFFFFF;
  --d5:#1590AF; --d5-ink:#FFFFFF;
  --font-display:"Noto Serif TC","Songti TC","Hiragino Mincho ProN","PMingLiU",serif;
  --font-latin:"Cormorant Garamond","Noto Serif TC",Georgia,serif;
  --font-body:"Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#101A22; --surface:#17242E; --surface-2:#1E2F3B; --fg:#E8EEF1; --muted:#9DB0BB; --line:#2B3E4B;
    --blue:#72A9C2; --blue-ink:#9CCBE2; --blue-soft:#1F3947;
    --panel:#1F4A60; --panel-ink:#F2F8FB;
    --plum:#D3B0BC; --mat:#ECE6DA;
    --stamp:#EE8A83; --stamp-soft:#3A2224;
    --d1:#6B3A45; --d1-ink:#FBE3E6;
    --d2:#4D5F14; --d2-ink:#EAF4C2;
    --d3:#6B5C1A; --d3-ink:#FAF0C0;
    --d4:#3E4A70; --d4-ink:#E3E8F6;
    --d5:#0B5B70; --d5-ink:#D8F2F9;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#101A22; --surface:#17242E; --surface-2:#1E2F3B; --fg:#E8EEF1; --muted:#9DB0BB; --line:#2B3E4B;
  --blue:#72A9C2; --blue-ink:#9CCBE2; --blue-soft:#1F3947;
  --panel:#1F4A60; --panel-ink:#F2F8FB;
  --plum:#D3B0BC; --mat:#ECE6DA;
  --stamp:#EE8A83; --stamp-soft:#3A2224;
  --d1:#6B3A45; --d1-ink:#FBE3E6;
  --d2:#4D5F14; --d2-ink:#EAF4C2;
  --d3:#6B5C1A; --d3-ink:#FAF0C0;
  --d4:#3E4A70; --d4-ink:#E3E8F6;
  --d5:#0B5B70; --d5-ink:#D8F2F9;
  color-scheme:dark;
}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:15px;line-height:1.75;-webkit-text-size-adjust:100%}
h1,h2,h3,h4,p,ul,ol{margin:0}
ul,ol{padding:0;list-style:none}
button{font:inherit;color:inherit;cursor:pointer}
a{color:inherit}
:focus-visible{outline:2px solid var(--blue-ink);outline-offset:2px}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));max-width:780px;margin-left:auto;margin-right:auto}
.d1{--dc:var(--d1);--dc-ink:var(--d1-ink)}
.d2{--dc:var(--d2);--dc-ink:var(--d2-ink)}
.d3{--dc:var(--d3);--dc-ink:var(--d3-ink)}
.d4{--dc:var(--d4);--dc-ink:var(--d4-ink)}
.d5{--dc:var(--d5);--dc-ink:var(--d5-ink)}

/* chapter strip */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.chips{display:flex;gap:8px;overflow-x:auto;padding-block:10px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;display:inline-flex;align-items:center;gap:7px;min-height:36px;padding:4px 14px;border:1px solid var(--line);border-radius:999px;background:var(--surface);font-size:13px;line-height:1.2;white-space:nowrap}
.chip i{width:9px;height:9px;border-radius:50%;background:var(--dc,var(--blue))}
.chip[aria-current="page"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}

main{padding-block:26px 56px}
.page[hidden]{display:none}
.eyebrow{font-family:var(--font-latin);font-weight:600;letter-spacing:.22em;text-transform:uppercase;font-size:.82rem;color:var(--blue-ink)}
.sec-title{font-family:var(--font-display);font-weight:700;font-size:1.45rem;line-height:1.35;color:var(--plum);text-wrap:balance}
.sub-title{font-family:var(--font-display);font-weight:700;font-size:1.1rem;color:var(--plum);margin-bottom:10px}
.stack{display:grid;gap:16px}
.lede{color:var(--muted);font-size:14px}

/* cover */
.cover{display:grid;justify-items:center;text-align:center;gap:12px;padding-block:10px 4px}
.cover h1{font-family:var(--font-latin);font-weight:500;font-size:clamp(2.3rem,12.5vw,4.2rem);letter-spacing:.06em;line-height:1.1}
.cover .where{font-family:var(--font-latin);font-weight:600;letter-spacing:.34em;font-size:.95rem;color:var(--blue-ink)}
.cover .when{font-family:var(--font-latin);font-weight:600;font-size:1.25rem;letter-spacing:.2em;font-variant-numeric:tabular-nums}
.count{display:inline-flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center;background:var(--blue-soft);color:var(--blue-ink);border-radius:999px;padding:6px 16px;font-size:14px;font-weight:500}
.count button{border:0;background:var(--blue-ink);color:var(--bg);border-radius:999px;padding:3px 12px;font-size:13px}
.trail{display:flex;flex-wrap:wrap;gap:8px 6px;align-items:center;justify-content:center;font-size:13px;margin-top:6px}
.trail .node{padding:3px 11px;border:1px solid var(--line);border-radius:999px;background:var(--surface)}
.trail .arr{color:var(--muted)}
.days{display:grid;gap:10px;margin-top:26px}
.daycard{display:grid;grid-template-columns:68px minmax(0,1fr);width:100%;padding:0;text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.daycard .k{background:var(--dc);color:var(--dc-ink);display:grid;place-content:center;text-align:center;font-family:var(--font-latin);font-weight:600;line-height:1.1;padding:10px 4px}
.daycard .k b{font-size:1.55rem;font-weight:600}
.daycard .k small{font-size:.78rem;letter-spacing:.06em;font-variant-numeric:tabular-nums}
.daycard .v{padding:10px 14px;min-width:0}
.daycard h3{font-family:var(--font-display);font-size:1.02rem;font-weight:700}
.daycard p{font-size:13px;color:var(--muted);line-height:1.6}
.quick{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:18px}
.quick button{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:10px 6px;font-size:13px}

/* generic */
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px;display:grid;gap:8px}
.card h3{font-family:var(--font-display);font-size:1.05rem;font-weight:700}
.card p{font-size:14px}
.meta-line{font-size:13px;color:var(--muted)}
.callout{background:var(--surface-2);border-radius:12px;padding:12px 14px;font-size:14px}
.callout b{color:var(--plum)}
.tag{display:inline-block;font-size:12px;line-height:1.6;padding:0 10px;border-radius:999px;background:var(--surface-2);color:var(--muted);margin-right:6px;white-space:nowrap}
.tag.stamp{background:var(--stamp-soft);color:var(--stamp);font-weight:500}
.tag.station{background:var(--blue-soft);color:var(--blue-ink)}
.tag.add{background:var(--surface-2);color:var(--plum)}

.map{display:inline-flex;align-items:center;gap:6px;flex:none;min-height:36px;padding:4px 13px;border-radius:999px;border:1px solid var(--blue);background:var(--blue-soft);color:var(--blue-ink);font-size:13px;font-weight:500;line-height:1.2;text-decoration:none;white-space:nowrap}
.map:hover{background:var(--blue);color:#fff}
.map .i{width:16px;height:16px}
.actions{display:flex;flex-wrap:wrap;gap:8px}

/* flights */
.pass{background:var(--panel);color:var(--panel-ink);border-radius:16px;padding:18px;display:grid;gap:14px}
.pass .legs{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:8px;align-items:center}
.pass .r{text-align:right}
.pass .day{font-size:.8rem;opacity:.9;font-variant-numeric:tabular-nums}
.pass .apt{font-family:var(--font-latin);font-weight:500;font-size:clamp(2.1rem,11vw,3rem);line-height:1;letter-spacing:.02em}
.pass .city{font-size:.85rem;opacity:.9}
.pass .mid{display:grid;gap:6px;justify-items:center;text-align:center;font-size:.72rem;min-width:74px}
.pass .dash{width:100%;border-top:2px dashed currentColor;opacity:.55}
.pass .info{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;text-align:center;border-top:1px dashed color-mix(in srgb,var(--panel-ink) 55%,transparent);padding-top:12px;font-size:.78rem}
.pass .info b{display:block;font-size:.98rem;font-weight:700}
.pass .info span{opacity:.85}

/* timeline */
.dayhead{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;background:var(--dc);color:var(--dc-ink);border-radius:16px;padding:16px 18px;margin-bottom:26px}
.dayhead .no{font-family:var(--font-latin);font-weight:600;font-size:2rem;letter-spacing:.08em;line-height:1}
.dayhead .ttl{font-family:var(--font-display);font-weight:700;font-size:1.15rem;text-align:right;text-wrap:balance}
.dayhead .dt{font-size:.85rem;font-variant-numeric:tabular-nums;opacity:.92;width:100%}
.timeline{display:grid}
.stop{position:relative;padding-left:30px;padding-bottom:30px;display:grid;gap:8px;align-content:start}
.stop::before{content:"";position:absolute;left:7px;top:10px;bottom:-2px;width:2px;background:var(--dc)}
.stop::after{content:"";position:absolute;left:0;top:5px;width:16px;height:16px;border-radius:50%;background:var(--dc);box-shadow:0 0 0 3px var(--bg),0 0 0 4px var(--dc)}
.stop:last-child{padding-bottom:6px}
.stop:last-child::before{display:none}
.stop h3{font-family:var(--font-display);font-size:1.2rem;font-weight:700;line-height:1.4;color:var(--plum)}
.stop p{font-size:14.5px}
.places{display:grid;gap:8px;margin-top:2px}
.places li{display:flex;gap:10px;align-items:center;justify-content:space-between;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
.places .nm{min-width:0}
.places b{display:block;font-weight:700;line-height:1.5}
.places small{display:block;font-size:13px;color:var(--muted);line-height:1.55}
.legs-list{display:grid;gap:0}
.legs-list li{display:flex;gap:10px;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px dashed var(--line)}
.legs-list li:first-child{border-top:0;padding-top:2px}
.legs-list .tx{min-width:0;font-size:14px}
.legs-list .tx b{font-weight:700}
.legs-list .tx small{display:block;font-size:12.5px;color:var(--muted);line-height:1.5}
.mode{display:inline-block;font-size:11.5px;padding:0 8px;border-radius:6px;background:var(--surface-2);color:var(--muted);margin-right:6px;vertical-align:1px}

/* shop */
.shop{display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
.shop .card{align-content:start;padding:10px;gap:6px}
.shop h3{font-size:.98rem;line-height:1.4}
.shop p{font-size:13px;line-height:1.6}
.shot{display:grid;place-items:center;height:132px;padding:10px;border-radius:10px;background:var(--mat);overflow:hidden}
.shot img{width:auto;height:auto;max-width:100%;max-height:112px;object-fit:contain;display:block}
.cover .where{background:none;padding:0;border-radius:0;justify-self:center}
.where{justify-self:start;font-size:12px;padding:0 10px;border-radius:999px;background:var(--blue-soft);color:var(--blue-ink)}

/* tax */
.steps{display:grid;gap:10px;counter-reset:s}
.steps li{display:grid;grid-template-columns:36px minmax(0,1fr);gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;counter-increment:s}
.steps li::before{content:counter(s);display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--panel);color:var(--panel-ink);font-family:var(--font-latin);font-weight:600;font-size:1.2rem}
.steps h3{font-family:var(--font-display);font-size:1.05rem;color:var(--plum)}
.steps p{font-size:14px}
.two{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}

/* packing */
.bar{height:8px;border-radius:999px;background:var(--surface-2);overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--blue);transition:width .25s}
.progress{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:13px;color:var(--muted)}
.progress button{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:3px 12px;font-size:13px}
.pack{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.pack .card{gap:0}
.pack h3{font-family:var(--font-latin);font-weight:600;letter-spacing:.16em;font-size:1rem;color:var(--blue-ink);padding-bottom:6px;border-bottom:1px solid var(--line)}
.pack label{display:flex;align-items:center;gap:12px;min-height:44px;border-bottom:1px solid var(--line);cursor:pointer;font-size:15px}
.pack li:last-child label{border-bottom:0}
.pack input{width:22px;height:22px;flex:none;accent-color:var(--blue-ink)}
.pack input:checked+span{color:var(--muted);text-decoration:line-through}

.pager{display:flex;justify-content:space-between;gap:10px;margin-top:34px}
.pager button{min-height:44px;border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:6px 16px;font-size:14px}
.pager .nx{margin-left:auto}
footer{padding-block:0 28px;font-size:12px;color:var(--muted);text-align:center}
@media (prefers-reduced-motion:reduce){.bar i{transition:none}}
</style>

